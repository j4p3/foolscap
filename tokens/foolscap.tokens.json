{
  "$description": "Foolscap design tokens — W3C DTCG format. An aged-newspaper / antique-engineering-schematic system: dark blue-green and gray serif text on creamy paper. Three tiers following Nathan Curtis's naming model: PRIMITIVE tokens (literal ramps, e.g. color.spruce.600), SEMANTIC tokens (purpose-named aliases, e.g. color.action.primary), and COMPONENT tokens (e.g. component.button.primary.background). Namespace when flattened to CSS custom properties: --fc-*. Dark mode ('blueprint') overrides live in $extensions['fc.modes'].dark.",

  "color": {
    "$type": "color",

    "cream": {
      "$description": "PRIMITIVE. The paper. Aged creamy stock, light to deep foxing.",
      "50":  { "$value": "#FCF9F1" },
      "100": { "$value": "#F6F0E1" },
      "200": { "$value": "#EFE6D0" },
      "300": { "$value": "#E3D6B8" },
      "400": { "$value": "#D3C098" },
      "500": { "$value": "#BFA878" }
    },

    "spruce": {
      "$description": "PRIMITIVE. The ink. Dark blue-green, the system's primary hue.",
      "50":  { "$value": "#EBF0EE" },
      "100": { "$value": "#D8E2DF" },
      "200": { "$value": "#B3C6C2" },
      "300": { "$value": "#8CA8A3" },
      "400": { "$value": "#628680" },
      "500": { "$value": "#476E67" },
      "600": { "$value": "#345852" },
      "700": { "$value": "#26453F" },
      "800": { "$value": "#1B3531" },
      "900": { "$value": "#122622" },
      "950": { "$value": "#0B1A17" }
    },

    "gray": {
      "$description": "PRIMITIVE. Cool slate gray, the secondary text ink.",
      "50":  { "$value": "#F0EFEB" },
      "100": { "$value": "#E2E1DB" },
      "200": { "$value": "#C8C7BF" },
      "300": { "$value": "#ABAAA1" },
      "400": { "$value": "#8C8C84" },
      "500": { "$value": "#65665F" },
      "600": { "$value": "#575850" },
      "700": { "$value": "#44453E" },
      "800": { "$value": "#32332E" },
      "900": { "$value": "#22231F" }
    },

    "prussian": {
      "$description": "PRIMITIVE. Engineering blue; ground of the dark 'blueprint' mode.",
      "100": { "$value": "#D6E1E7" },
      "300": { "$value": "#8FAAB8" },
      "500": { "$value": "#3E6C82" },
      "600": { "$value": "#2F576B" },
      "700": { "$value": "#234453" },
      "800": { "$value": "#17303C" },
      "900": { "$value": "#0E212B" },
      "950": { "$value": "#081720" }
    },

    "ochre": {
      "$description": "PRIMITIVE. Highlighter and aged gilt.",
      "100": { "$value": "#F7ECC7" },
      "200": { "$value": "#F1DF9F" },
      "300": { "$value": "#EACF74" },
      "400": { "$value": "#DDBB4E" },
      "500": { "$value": "#C49F33" },
      "600": { "$value": "#9F7E26" },
      "700": { "$value": "#775D1C" }
    },

    "rust": {
      "$description": "PRIMITIVE. Stamp red / oxide. Destructive and danger.",
      "100": { "$value": "#F2DDD3" },
      "300": { "$value": "#D9A183" },
      "500": { "$value": "#B26545" },
      "600": { "$value": "#97482B" },
      "700": { "$value": "#7A3820" },
      "800": { "$value": "#5C2A18" }
    },

    "olive": {
      "$description": "PRIMITIVE. Drafting-table green. Success and approval.",
      "100": { "$value": "#E7E8D2" },
      "300": { "$value": "#BFC496" },
      "500": { "$value": "#7C8449" },
      "600": { "$value": "#5F6836" },
      "700": { "$value": "#495028" }
    },

    "ink": {
      "$description": "PRIMITIVE. Graph inks: dark categorical inks for paper and pale counterparts for the blueprint ground. Graphite reuses the gray ramp.",
      "forest":        { "$value": "#2E5E3E" },
      "forest-pale":   { "$value": "#93C4A0" },
      "blue":          { "$value": "#26497A" },
      "blue-pale":     { "$value": "#9CB9E3" },
      "oxblood":       { "$value": "#7C2B33" },
      "oxblood-pale":  { "$value": "#E3A3A9" },
      "umber":         { "$value": "#6A4524" },
      "umber-pale":    { "$value": "#D6B48E" }
    },

    "surface": {
      "$description": "SEMANTIC. Grounds and planes.",
      "page":    { "$value": "{color.cream.100}", "$description": "Default page ground.", "$extensions": { "fc.modes": { "dark": "{color.prussian.950}" } } },
      "raised":  { "$value": "{color.cream.50}",  "$description": "Panes, cards, anything sitting on the page.", "$extensions": { "fc.modes": { "dark": "{color.prussian.900}" } } },
      "sunken":  { "$value": "{color.cream.200}", "$description": "Wells, table stripes, inset regions.", "$extensions": { "fc.modes": { "dark": "{color.prussian.800}" } } },
      "aged":    { "$value": "{color.cream.300}", "$description": "Deeply aged panel; folio edges, colophons.", "$extensions": { "fc.modes": { "dark": "{color.prussian.700}" } } },
      "inverse": { "$value": "{color.spruce.900}", "$description": "Ink-ground plate; inverse panes.", "$extensions": { "fc.modes": { "dark": "{color.cream.100}" } } }
    },

    "text": {
      "$description": "SEMANTIC. Inks.",
      "primary":   { "$value": "{color.spruce.800}", "$description": "Body ink. Dark blue-green.", "$extensions": { "fc.modes": { "dark": "{color.cream.100}" } } },
      "secondary": { "$value": "{color.gray.600}", "$description": "Secondary gray ink: decks, bylines, supporting prose.", "$extensions": { "fc.modes": { "dark": "{color.gray.200}" } } },
      "muted":     { "$value": "{color.gray.500}", "$description": "Captions, footnotes, folio lines.", "$extensions": { "fc.modes": { "dark": "{color.gray.300}" } } },
      "faint":     { "$value": "{color.gray.400}", "$description": "Disabled text, watermarks. Decorative only below AA.", "$extensions": { "fc.modes": { "dark": "{color.gray.400}" } } },
      "inverse":   { "$value": "{color.cream.100}", "$description": "Text on inverse/ink surfaces.", "$extensions": { "fc.modes": { "dark": "{color.spruce.900}" } } },
      "link":      { "$value": "{color.spruce.600}", "$extensions": { "fc.modes": { "dark": "{color.spruce.300}" } } },
      "link-hover": { "$value": "{color.spruce.800}", "$extensions": { "fc.modes": { "dark": "{color.spruce.200}" } } }
    },

    "action": {
      "$description": "SEMANTIC. Interactive intent.",
      "primary":        { "$value": "{color.spruce.700}", "$extensions": { "fc.modes": { "dark": "{color.cream.100}" } } },
      "primary-hover":  { "$value": "{color.spruce.900}", "$extensions": { "fc.modes": { "dark": "{color.cream.50}" } } },
      "on-primary":     { "$value": "{color.cream.100}", "$extensions": { "fc.modes": { "dark": "{color.prussian.950}" } } },
      "secondary":      { "$value": "{color.spruce.800}", "$description": "Outline-button ink and border.", "$extensions": { "fc.modes": { "dark": "{color.cream.100}" } } },
      "destructive":       { "$value": "{color.rust.600}", "$extensions": { "fc.modes": { "dark": "{color.rust.300}" } } },
      "destructive-hover": { "$value": "{color.rust.800}", "$extensions": { "fc.modes": { "dark": "{color.rust.100}" } } },
      "on-destructive":    { "$value": "{color.cream.50}", "$extensions": { "fc.modes": { "dark": "{color.prussian.950}" } } }
    },

    "border": {
      "$description": "SEMANTIC. Rules and hairlines.",
      "hairline": { "$value": "#C9BEA6", "$description": "Default 1px rule on paper (reads as ink at ~30%).", "$extensions": { "fc.modes": { "dark": "#2C4450" } } },
      "mid":      { "$value": "{color.gray.400}", "$extensions": { "fc.modes": { "dark": "{color.gray.500}" } } },
      "strong":   { "$value": "{color.spruce.800}", "$description": "Emphatic rules: mastheads, pane frames, buttons.", "$extensions": { "fc.modes": { "dark": "{color.cream.100}" } } },
      "focus":    { "$value": "{color.ochre.500}", "$description": "Focus ring.", "$extensions": { "fc.modes": { "dark": "{color.ochre.300}" } } }
    },

    "emphasis": {
      "$description": "SEMANTIC. The offset-highlighter treatment — the system's single strong-emphasis device.",
      "highlight":     { "$value": "{color.ochre.300}", "$extensions": { "fc.modes": { "dark": "{color.ochre.500}" } } },
      "highlight-ink": { "$value": "{color.spruce.900}", "$description": "Ink over a highlight swipe.", "$extensions": { "fc.modes": { "dark": "{color.prussian.950}" } } },
      "plate":         { "$value": "{color.ochre.400}", "$description": "Offset plate backing for block-level emphasis.", "$extensions": { "fc.modes": { "dark": "{color.ochre.500}" } } }
    },

    "feedback": {
      "$description": "SEMANTIC. Status inks and their tints.",
      "info":            { "$value": "{color.prussian.600}", "$extensions": { "fc.modes": { "dark": "{color.prussian.300}" } } },
      "info-surface":    { "$value": "{color.prussian.100}", "$extensions": { "fc.modes": { "dark": "{color.prussian.800}" } } },
      "success":         { "$value": "{color.olive.600}", "$extensions": { "fc.modes": { "dark": "{color.olive.300}" } } },
      "success-surface": { "$value": "{color.olive.100}", "$extensions": { "fc.modes": { "dark": "#22301C" } } },
      "warning":         { "$value": "{color.ochre.700}", "$extensions": { "fc.modes": { "dark": "{color.ochre.300}" } } },
      "warning-surface": { "$value": "{color.ochre.100}", "$extensions": { "fc.modes": { "dark": "#2E2712" } } },
      "danger":          { "$value": "{color.rust.600}", "$extensions": { "fc.modes": { "dark": "{color.rust.300}" } } },
      "danger-surface":  { "$value": "{color.rust.100}", "$extensions": { "fc.modes": { "dark": "#331B12" } } }
    },

    "chart": {
      "$description": "SEMANTIC. Figure inks: a muted engineering-ink categorical ramp plus chart furniture.",
      "1": { "$value": "{color.spruce.600}", "$extensions": { "fc.modes": { "dark": "{color.spruce.300}" } } },
      "2": { "$value": "{color.rust.500}", "$extensions": { "fc.modes": { "dark": "{color.rust.300}" } } },
      "3": { "$value": "{color.prussian.500}", "$extensions": { "fc.modes": { "dark": "{color.prussian.300}" } } },
      "4": { "$value": "{color.ochre.600}", "$description": "Ochre-600 on paper: ochre-500 measured 2.2:1 and failed the 3:1 graphics floor.", "$extensions": { "fc.modes": { "dark": "{color.ochre.300}" } } },
      "5": { "$value": "{color.olive.500}", "$extensions": { "fc.modes": { "dark": "{color.olive.300}" } } },
      "6": { "$value": "{color.gray.500}", "$extensions": { "fc.modes": { "dark": "{color.gray.300}" } } },
      "grid": { "$value": "#D9CEB4", "$description": "Graph-paper grid lines.", "$extensions": { "fc.modes": { "dark": "#1D3641" } } },
      "axis": { "$value": "{color.gray.600}", "$extensions": { "fc.modes": { "dark": "{color.gray.300}" } } },
      "ink":  { "$value": "{color.spruce.800}", "$description": "Default mark ink for single-series figures.", "$extensions": { "fc.modes": { "dark": "{color.cream.100}" } } }
    }
  },

  "font": {
    "family": {
      "$type": "fontFamily",
      "$description": "PRIMITIVE. Three faces only.",
      "display": { "$value": ["Playfair Display", "Georgia", "serif"], "$description": "Mastheads, headlines. High-contrast didone." },
      "text":    { "$value": ["Lora", "Georgia", "serif"], "$description": "Body prose and UI text." },
      "data":    { "$value": ["IBM Plex Mono", "ui-monospace", "monospace"], "$description": "Labels, chips, buttons, axes, tables of figures — the schematic voice." }
    },
    "weight": {
      "$type": "fontWeight",
      "$description": "PRIMITIVE.",
      "regular":  { "$value": 400 },
      "medium":   { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold":     { "$value": 700 },
      "black":    { "$value": 800, "$description": "Playfair Display only; mastheads." }
    },
    "size": {
      "$type": "dimension",
      "$description": "PRIMITIVE. Type scale (rem; 16px root). Ratio ≈ 1.2 with editorial jumps at the top.",
      "caption":  { "$value": "0.75rem" },
      "small":    { "$value": "0.875rem" },
      "body":     { "$value": "1rem" },
      "prose":    { "$value": "1.0625rem", "$description": "Long-form article body." },
      "lede":     { "$value": "1.1875rem" },
      "h4":       { "$value": "1.3125rem" },
      "h3":       { "$value": "1.5rem" },
      "h2":       { "$value": "1.875rem" },
      "h1":       { "$value": "2.375rem" },
      "display":  { "$value": "3.25rem" },
      "masthead": { "$value": "4.25rem" }
    },
    "line-height": {
      "$type": "dimension",
      "$description": "PRIMITIVE. All line heights sit on the 4px baseline grid.",
      "caption":  { "$value": "1rem" },
      "small":    { "$value": "1.25rem" },
      "body":     { "$value": "1.5rem" },
      "prose":    { "$value": "1.75rem", "$description": "The 28px prose baseline." },
      "lede":     { "$value": "1.75rem" },
      "h4":       { "$value": "1.75rem" },
      "h3":       { "$value": "2rem" },
      "h2":       { "$value": "2.25rem" },
      "h1":       { "$value": "2.75rem" },
      "display":  { "$value": "3.5rem" },
      "masthead": { "$value": "4.25rem" }
    },
    "tracking": {
      "$type": "dimension",
      "$description": "PRIMITIVE. Letterspacing.",
      "tight":  { "$value": "-0.01em", "$description": "Display sizes." },
      "normal": { "$value": "0em" },
      "caps":   { "$value": "0.08em", "$description": "Small caps runs, bylines." },
      "label":  { "$value": "0.14em", "$description": "Mono caps labels, chips, buttons, figure labels." }
    }
  },

  "space": {
    "$type": "dimension",
    "$description": "PRIMITIVE. 4px-grid spatial scale. Vertical margins are multiples of these.",
    "1":  { "$value": "0.25rem" },
    "2":  { "$value": "0.5rem" },
    "3":  { "$value": "0.75rem" },
    "4":  { "$value": "1rem" },
    "5":  { "$value": "1.5rem" },
    "6":  { "$value": "1.75rem", "$description": "One prose baseline (28px)." },
    "7":  { "$value": "2rem" },
    "8":  { "$value": "3rem" },
    "9":  { "$value": "3.5rem", "$description": "Two prose baselines." },
    "10": { "$value": "4rem" },
    "11": { "$value": "6rem" },
    "12": { "$value": "8rem" },
    "13": { "$value": "12rem", "$description": "Graph-paper major cell." }
  },

  "size": {
    "$type": "dimension",
    "$description": "SEMANTIC. Layout measures.",
    "measure-prose":  { "$value": "42rem", "$description": "Single-column article measure (~66ch at prose size)." },
    "measure-wide":   { "$value": "64rem", "$description": "Figures, tables, wide panes." },
    "measure-page":   { "$value": "76rem", "$description": "Page shell max-width." },
    "control-height": { "$value": "2.5rem", "$description": "Buttons, inputs (40px; 44px+ tap target with border)." },
    "figure-min-height": { "$value": "28rem", "$description": "Minimum height of interactive figures (graphs, pannable plates) so they never collapse to a strip." },
    "touch-target": { "$value": "2.75rem", "$description": "44px minimum exposed pointer/touch target." },
    "panel-width": { "$value": "22rem", "$description": "Floating detail panel over a figure." },
    "panel-width-narrow": { "$value": "16rem", "$description": "Floating key / legend panel over a figure." },
    "panel-max-height": { "$value": "24rem", "$description": "Tallest a floating key may grow before it scrolls." }
  },

  "radius": {
    "$type": "dimension",
    "$description": "PRIMITIVE. Print is square. Radii are small and rare.",
    "none": { "$value": "0rem", "$description": "Default: panes, buttons, figures." },
    "tick": { "$value": "0.125rem", "$description": "Chips, inputs, kbd — takes the edge off." },
    "soft": { "$value": "0.25rem", "$description": "Images and large surfaces only." },
    "full": { "$value": "624.9375rem", "$description": "Status dots and index counters only." }
  },

  "border": {
    "width": {
      "$type": "dimension",
      "$description": "PRIMITIVE. Rule weights.",
      "hairline": { "$value": "0.0625rem" },
      "rule":     { "$value": "0.09375rem", "$description": "1.5px — buttons, pane frames." },
      "bold":     { "$value": "0.125rem", "$description": "2px — between rule and heavy; ordinal stroke steps in figures." },
      "heavy":    { "$value": "0.1875rem", "$description": "3px — masthead bars, emphatic rules." }
    },
    "dash": {
      "$type": "strokeStyle",
      "$description": "PRIMITIVE. SVG stroke dash patterns (DTCG strokeStyle objects; emitted as stroke-dasharray lists, empty = none).",
      "solid":  { "$value": { "dashArray": [], "lineCap": "butt" } },
      "long":   { "$value": { "dashArray": ["0.375rem", "0.1875rem"], "lineCap": "butt" }, "$description": "6/3 — marquee, selection, focus." },
      "short":  { "$value": { "dashArray": ["0.1875rem", "0.125rem"], "lineCap": "butt" }, "$description": "3/2 — leader lines, tentative links." },
      "dotted": { "$value": { "dashArray": ["0.0625rem", "0.1875rem"], "lineCap": "butt" }, "$description": "1/3 — faint, far, provisional." },
      "dash-dot": { "$value": { "dashArray": ["0.5rem", "0.1875rem", "0.0625rem", "0.1875rem"], "lineCap": "butt" }, "$description": "8/3/1/3 — summaries and aggregates (never a real single link)." }
    },
    "style": {
      "$type": "strokeStyle",
      "$description": "PRIMITIVE.",
      "solid":  { "$value": "solid" },
      "dashed": { "$value": "dashed", "$description": "Schematic annotation: leader lines, cut lines, chart grids." },
      "double": { "$value": "double", "$description": "Newspaper section rules." },
      "dotted": { "$value": "dotted", "$description": "Footnote separators, index leaders." }
    }
  },

  "shadow": {
    "$description": "SEMANTIC. No blur anywhere — depth is misregistration, not atmosphere.",
    "plate": {
      "$type": "shadow",
      "$value": { "color": "{color.emphasis.plate}", "offsetX": "0.375rem", "offsetY": "0.375rem", "blur": "0rem", "spread": "0rem" },
      "$description": "Offset highlighter plate: strong block emphasis."
    },
    "plate-ink": {
      "$type": "shadow",
      "$value": { "color": "{color.action.primary}", "offsetX": "0.375rem", "offsetY": "0.375rem", "blur": "0rem", "spread": "0rem" },
      "$description": "Ink plate: emphasized panes and CTAs."
    },
    "plate-sm": {
      "$type": "shadow",
      "$value": { "color": "{color.emphasis.plate}", "offsetX": "0.1875rem", "offsetY": "0.1875rem", "blur": "0rem", "spread": "0rem" },
      "$description": "Small offset for buttons and chips."
    }
  },

  "motion": {
    "$description": "PRIMITIVE. Motion is discreet: state changes, not theater.",
    "duration": {
      "$type": "duration",
      "fast":   { "$value": "120ms" },
      "gentle": { "$value": "240ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "out":   { "$value": [0.2, 0, 0, 1] },
      "inout": { "$value": [0.45, 0, 0.15, 1] }
    }
  },

  "typography": {
    "$type": "typography",
    "$description": "SEMANTIC. Composite styles for the recurring editorial voices.",
    "masthead": {
      "$value": { "fontFamily": "{font.family.display}", "fontSize": "{font.size.masthead}", "fontWeight": "{font.weight.black}", "lineHeight": "{font.line-height.masthead}", "letterSpacing": "{font.tracking.tight}" }
    },
    "headline": {
      "$value": { "fontFamily": "{font.family.display}", "fontSize": "{font.size.h1}", "fontWeight": "{font.weight.bold}", "lineHeight": "{font.line-height.h1}", "letterSpacing": "{font.tracking.tight}" }
    },
    "prose": {
      "$value": { "fontFamily": "{font.family.text}", "fontSize": "{font.size.prose}", "fontWeight": "{font.weight.regular}", "lineHeight": "{font.line-height.prose}", "letterSpacing": "{font.tracking.normal}" }
    },
    "label": {
      "$value": { "fontFamily": "{font.family.data}", "fontSize": "{font.size.caption}", "fontWeight": "{font.weight.semibold}", "lineHeight": "{font.line-height.caption}", "letterSpacing": "{font.tracking.label}" },
      "$description": "The schematic voice: uppercase mono. Chips, buttons, figure labels, axes."
    }
  },

  "component": {
    "$description": "COMPONENT tier. Named per element; every value aliases the semantic tier.",
    "button": {
      "$type": "color",
      "primary": {
        "background": { "$value": "{color.action.primary}" },
        "background-hover": { "$value": "{color.action.primary-hover}" },
        "text": { "$value": "{color.action.on-primary}" },
        "border": { "$value": "{color.action.primary}" }
      },
      "secondary": {
        "background": { "$value": "#00000000", "$description": "Transparent; paper shows through." },
        "text": { "$value": "{color.action.secondary}" },
        "border": { "$value": "{color.action.secondary}" }
      },
      "ghost": {
        "background": { "$value": "#00000000" },
        "text": { "$value": "{color.text.link}" },
        "border": { "$value": "#00000000" }
      },
      "destructive": {
        "background": { "$value": "{color.action.destructive}" },
        "background-hover": { "$value": "{color.action.destructive-hover}" },
        "text": { "$value": "{color.action.on-destructive}" },
        "border": { "$value": "{color.action.destructive}" }
      }
    },
    "chip": {
      "$type": "color",
      "background": { "$value": "#00000000" },
      "text": { "$value": "{color.text.secondary}" },
      "border": { "$value": "{color.border.mid}" },
      "selected-background": { "$value": "{color.emphasis.highlight}" },
      "selected-text": { "$value": "{color.emphasis.highlight-ink}" },
      "selected-border": { "$value": "{color.border.strong}" }
    },
    "pane": {
      "$type": "color",
      "background": { "$value": "{color.surface.raised}" },
      "border": { "$value": "{color.border.hairline}" },
      "header-text": { "$value": "{color.text.muted}" },
      "inverse-background": { "$value": "{color.surface.inverse}" },
      "inverse-text": { "$value": "{color.text.inverse}" }
    },
    "input": {
      "$type": "color",
      "background": { "$value": "{color.surface.raised}" },
      "text": { "$value": "{color.text.primary}" },
      "border": { "$value": "{color.border.mid}" },
      "border-focus": { "$value": "{color.border.strong}" },
      "placeholder": { "$value": "{color.text.faint}" }
    },
    "table": {
      "$type": "color",
      "header-text": { "$value": "{color.text.muted}" },
      "rule": { "$value": "{color.border.hairline}" },
      "stripe": { "$value": "{color.surface.sunken}" }
    },
    "mark": {
      "$type": "color",
      "background": { "$value": "{color.emphasis.highlight}" },
      "text": { "$value": "{color.emphasis.highlight-ink}" }
    },
    "graph": {
      "$description": "Node-link figure: labelled point marks on a graph-paper plate. Generic channels — series (categorical fill), texture (fill pattern), size (radius), shape (silhouette), proximity (outer ring colour + width + dash, ordinal past→now→near→far→none).",
      "background": { "$type": "color", "$value": "{color.surface.raised}" },
      "border":     { "$type": "color", "$value": "{color.border.hairline}" },
      "canvas": {
        "min-height": { "$type": "dimension", "$value": "{size.figure-min-height}" }
      },
      "grid": {
        "line":       { "$type": "color", "$value": "{color.chart.grid}" },
        "line-major": { "$type": "color", "$value": "{color.border.hairline}" },
        "size":       { "$type": "dimension", "$value": "{space.8}", "$description": "Minor graph-paper cell (3rem, 48px). Background paper only, not a placement lattice." },
        "size-major": { "$type": "dimension", "$value": "{space.13}", "$description": "Major cell = 4 minor (12rem, 192px)." },
        "minor-min-scale": { "$type": "number", "$value": 0.6, "$description": "Unitless view scale below which minor grid lines are hidden (fcGraph.minorGridVisible)." }
      },
      "node": {
        "fill":       { "$type": "color", "$value": "{color.chart.ink}", "$description": "Fill when no series is assigned: ink-bearing neutral so the mark and its texture clear 3:1." },
        "fill-open":  { "$type": "color", "$value": "{color.surface.raised}", "$description": "Hollow (texture-open) interior." },
        "outline":    { "$type": "color", "$value": "{color.border.strong}" },
        "outline-width":        { "$type": "dimension", "$value": "{border.width.hairline}" },
        "outline-width-active": { "$type": "dimension", "$value": "{border.width.bold}" },
        "opacity-dimmed": { "$type": "number", "$value": 0.35 },
        "radius-sm":  { "$type": "dimension", "$value": "{space.2}", "$description": "8px — light weight." },
        "radius-md":  { "$type": "dimension", "$value": "{space.3}", "$description": "12px — default weight." },
        "radius-lg":  { "$type": "dimension", "$value": "{space.4}", "$description": "16px — heavy weight." },
        "hit-radius": { "$type": "dimension", "$value": "{space.5}", "$description": "24px invisible hit disc (48px target) regardless of drawn size." }
      },
      "focus": {
        "ring":   { "$type": "color", "$value": "{color.border.strong}" },
        "width":  { "$type": "dimension", "$value": "{border.width.bold}" },
        "offset": { "$type": "dimension", "$value": "{space.1}", "$description": "Paper gap between the proximity ring's outer edge and the focus/selection ring." },
        "dash":   { "$type": "strokeStyle", "$value": "{border.dash.long}" }
      },
      "label": {
        "text":  { "$type": "color", "$value": "{color.text.primary}" },
        "muted": { "$type": "color", "$value": "{color.text.muted}" },
        "halo":  { "$type": "color", "$value": "{color.surface.raised}", "$description": "Paint-order knockout behind label text; matches graph background." },
        "halo-width": { "$type": "dimension", "$value": "{border.width.heavy}" },
        "gap":   { "$type": "dimension", "$value": "{space.1}", "$description": "Label offset from the outermost ring." },
        "font-family": { "$type": "fontFamily", "$value": "{font.family.data}" },
        "font-size":   { "$type": "dimension", "$value": "{font.size.caption}" },
        "font-weight": { "$type": "fontWeight", "$value": "{font.weight.medium}" },
        "font-weight-active": { "$type": "fontWeight", "$value": "{font.weight.bold}" },
        "line-height": { "$type": "dimension", "$value": "{font.line-height.caption}", "$description": "Line pitch of wrapped labels (measurement input for layout)." }
      },
      "edge": {
        "line":           { "$type": "color", "$value": "{color.text.muted}" },
        "line-emphasis":  { "$type": "color", "$value": "{color.border.strong}" },
        "width":          { "$type": "dimension", "$value": "{border.width.hairline}" },
        "width-emphasis": { "$type": "dimension", "$value": "{border.width.rule}" },
        "opacity-dimmed": { "$type": "number", "$value": 0.25, "$description": "Edges outside a focused stream. Decoration only; the edge table carries the data." }
      },
      "dash": { "$type": "strokeStyle", "$value": "{border.dash.short}", "$description": "Tentative/soft edges." },
      "series": {
        "$type": "color",
        "$description": "Categorical fill ramp; aliases the chart ramp so graphs and charts share a palette.",
        "1": { "$value": "{color.chart.1}" },
        "2": { "$value": "{color.chart.2}" },
        "3": { "$value": "{color.chart.3}" },
        "4": { "$value": "{color.chart.4}" },
        "5": { "$value": "{color.chart.5}" },
        "6": { "$value": "{color.chart.6}" }
      },
      "texture": {
        "ink":          { "$type": "color", "$value": "{color.surface.raised}", "$description": "Pattern strokes drawn over the series fill (paper-on-ink in light, blueprint-on-chalk in dark)." },
        "gap":          { "$type": "dimension", "$value": "{space.1}" },
        "stroke-width": { "$type": "dimension", "$value": "{border.width.hairline}" },
        "dot-radius":   { "$type": "dimension", "$value": "{border.width.hairline}" }
      },
      "halo": {
        "gap": { "$type": "dimension", "$value": "{border.width.bold}", "$description": "Paper gap between node edge and proximity ring." }
      },
      "proximity": {
        "$description": "Ordinal ring: colour + width + dash all step together so no state is colour-only.",
        "past": {
          "color": { "$type": "color", "$value": "{color.feedback.danger}" },
          "width": { "$type": "dimension", "$value": "{border.width.heavy}" },
          "dash":  { "$type": "strokeStyle", "$value": "{border.dash.solid}" }
        },
        "now": {
          "color": { "$type": "color", "$value": "{color.feedback.warning}" },
          "width": { "$type": "dimension", "$value": "{border.width.bold}" },
          "dash":  { "$type": "strokeStyle", "$value": "{border.dash.solid}" }
        },
        "near": {
          "color": { "$type": "color", "$value": "{color.feedback.info}" },
          "width": { "$type": "dimension", "$value": "{border.width.rule}" },
          "dash":  { "$type": "strokeStyle", "$value": "{border.dash.short}" }
        },
        "far": {
          "color": { "$type": "color", "$value": "{color.text.muted}" },
          "width": { "$type": "dimension", "$value": "{border.width.hairline}" },
          "dash":  { "$type": "strokeStyle", "$value": "{border.dash.dotted}" }
        },
        "none": {
          "color": { "$type": "color", "$value": "#00000000" },
          "width": { "$type": "dimension", "$value": "{radius.none}" },
          "dash":  { "$type": "strokeStyle", "$value": "{border.dash.solid}" }
        }
      },
      "ink": {
        "$type": "color",
        "$description": "Five fixed categorical ink slots plus a neutral No texture treatment. Slot ORDER is part of the visual contract (fc.palette.version); consuming apps own the category-to-slot mapping. Pale counterparts re-theme for the blueprint ground.",
        "$extensions": { "fc.palette": { "version": 1, "slots": ["forest", "blue", "oxblood", "umber", "graphite"] } },
        "1":    { "$value": "{color.ink.forest}",  "$description": "Slot 1 — forest green.", "$extensions": { "fc.modes": { "dark": "{color.ink.forest-pale}" } } },
        "2":    { "$value": "{color.ink.blue}",    "$description": "Slot 2 — deep blue.", "$extensions": { "fc.modes": { "dark": "{color.ink.blue-pale}" } } },
        "3":    { "$value": "{color.ink.oxblood}", "$description": "Slot 3 — oxblood.", "$extensions": { "fc.modes": { "dark": "{color.ink.oxblood-pale}" } } },
        "4":    { "$value": "{color.ink.umber}",   "$description": "Slot 4 — umber.", "$extensions": { "fc.modes": { "dark": "{color.ink.umber-pale}" } } },
        "5":    { "$value": "{color.gray.700}",    "$description": "Slot 5 — graphite.", "$extensions": { "fc.modes": { "dark": "{color.gray.200}" } } },
        "none": { "$value": "{color.gray.400}",    "$description": "No texture: neutral mid-grey, lighter than graphite in paper mode and darker in blueprint mode; always paired with a dashed outline and the words 'No texture'.", "$extensions": { "fc.modes": { "dark": "{color.gray.400}" } } }
      },
      "objective": {
        "$description": "Objective landmark: a bracketed title with no task glyph. Root vs nested is structure within the shown snapshot, never priority.",
        "bracket":        { "$type": "color", "$value": "{color.border.strong}" },
        "bracket-width":  { "$type": "dimension", "$value": "{border.width.rule}", "$description": "Selected objectives step up to border.width.heavy." },
        "bracket-arm":    { "$type": "dimension", "$value": "{space.3}", "$description": "Corner arm length (clamped to half the box by fcGraph.bracketPath)." },
        "padding-x":      { "$type": "dimension", "$value": "{space.2}" },
        "padding-y":      { "$type": "dimension", "$value": "{space.1}" },
        "font-size-root":     { "$type": "dimension", "$value": "{font.size.body}" },
        "font-size-nested":   { "$type": "dimension", "$value": "{font.size.small}" },
        "font-weight-root":   { "$type": "fontWeight", "$value": "{font.weight.bold}" },
        "font-weight-nested": { "$type": "fontWeight", "$value": "{font.weight.semibold}" },
        "caption":        { "$type": "color", "$value": "{color.text.muted}", "$description": "OBJECTIVE caption and progress text." }
      },
      "hit": {
        "touch-min": { "$type": "dimension", "$value": "{size.touch-target}", "$description": "Minimum exposed touch target (44px)." }
      },
      "link": {
        "handle-radius":  { "$type": "dimension", "$value": "{space.2}", "$description": "Drawn handle; its hit area still honours hit.touch-min." },
        "preview-line":   { "$type": "color", "$value": "{color.border.strong}" },
        "preview-dash":   { "$type": "strokeStyle", "$value": "{border.dash.long}" },
        "target-valid":   { "$type": "color", "$value": "{color.feedback.success}" },
        "target-invalid": { "$type": "color", "$value": "{color.feedback.danger}" }
      },
      "stream": {
        "edge-width": { "$type": "dimension", "$value": "{border.width.bold}", "$description": "Edges inside a focused stream (heavier than edge.width-emphasis)." }
      },
      "aggregate": {
        "dash": { "$type": "strokeStyle", "$value": "{border.dash.dash-dot}", "$description": "Summary edge standing for several canonical edges." }
      },
      "done": {
        "mark": { "$type": "color", "$value": "{color.text.primary}", "$description": "Check mark on completed context where it sits on paper: the hollow texture-open interior (and the plate). Matches label.text, so it clears 3:1 on node.fill-open in both themes." },
        "mark-filled": { "$type": "color", "$value": "{color.surface.raised}", "$description": "Check mark on a filled glyph (any ink, No texture, series or default fill): the plate/halo colour knocked out of the fill, like texture.ink. Never used on the hollow open texture, where it would vanish (1:1)." }
      },
      "inset": {
        "width":      { "$type": "dimension", "$value": "{size.panel-width}" },
        "max-height": { "$type": "dimension", "$value": "{size.figure-min-height}", "$description": "Never taller than the smallest canvas; CSS also clamps to the figure." },
        "offset":     { "$type": "dimension", "$value": "{space.3}", "$description": "Gap between floating panels and the canvas edge." },
        "background": { "$type": "color", "$value": "{color.surface.raised}" },
        "border":     { "$type": "color", "$value": "{color.border.strong}" },
        "shadow":     { "$type": "shadow", "$value": "{shadow.plate-sm}", "$description": "Offset plate, no blur." }
      },
      "key": {
        "width":      { "$type": "dimension", "$value": "{size.panel-width-narrow}" },
        "max-height": { "$type": "dimension", "$value": "{size.panel-max-height}" }
      },
      "legend": {
        "glyph-size":  { "$type": "dimension", "$value": "{space.7}", "$description": "32px glyph box fits a lg node + ring." },
        "swatch-size": { "$type": "dimension", "$value": "{space.3}" },
        "gap":         { "$type": "dimension", "$value": "{space.2}" }
      },
      "controls": {
        "gap": { "$type": "dimension", "$value": "{space.1}" }
      }
    }
  }
}
